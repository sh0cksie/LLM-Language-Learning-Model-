<Page x:Class="Baseapp.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Baseapp"

      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">
    <Border CornerRadius="10" Background="AliceBlue">
        <WrapPanel x:Name="CardPanel" Orientation="Horizontal" Margin="10">
            <WrapPanel.Resources>
                <Style TargetType="{x:Type local:CardControl}">
                    <Setter Property="Margin" Value="5,5" />
                </Style>
            </WrapPanel.Resources>
        </WrapPanel>
    </Border>
</Page>
