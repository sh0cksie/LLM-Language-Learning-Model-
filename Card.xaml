<UserControl x:Class="Baseapp.Card"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Baseapp"
      mc:Ignorable="d"
      d:DesignHeight="100" d:DesignWidth="200"
      MinWidth="200" MinHeight="100" MaxWidth="200" MaxHeight="100">
    <Grid>
        <Border CornerRadius="40,0,0,40" BorderThickness="1" BorderBrush="#5B779F" Background="#4B525B" Margin="0,0,100,0" Grid.RowSpan="2">
            <TextBlock Text="placeholder1" TextWrapping="Wrap" Grid.Row="0"  Grid.RowSpan="3" Margin="14,10,10,10"/>
        </Border>
        <Border CornerRadius="0,40,40,0" BorderThickness="1" BorderBrush="#5B779F" Background="#FFA5969C" Margin="100,0,0,0" Grid.RowSpan="2">
            <TextBlock Text="placeholder2" TextWrapping="Wrap" Grid.Row="1" Grid.RowSpan="3" Margin="10,10,14,10"/>
        </Border>
    </Grid>
</UserControl>
