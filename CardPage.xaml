<Page x:Class="Card.CardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Card"
      mc:Ignorable="d" 
      d:DesignHeight="100" d:DesignWidth="200"
      Title="CardPage" MinWidth="200" MinHeight="100" MaxWidth="200" MaxHeight="100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border CornerRadius="40,0,0,40" BorderThickness="1" BorderBrush="#30D5C8" Background="#b0f4f0" Margin="0,0,100,0" Grid.RowSpan="2">
            <TextBlock Text="placeholder1" TextWrapping="Wrap" Grid.Row="0"  Grid.RowSpan="3" Margin="14,10,10,10"/>
        </Border>
        <Border CornerRadius="0,40,40,0" BorderThickness="1" BorderBrush="#30D5C8" Background="#e0f1f0" Margin="100,0,0,0" Grid.RowSpan="2">
            <TextBlock Text="placeholder2" TextWrapping="Wrap" Grid.Row="1" Grid.RowSpan="3" Margin="10,10,14,10"/>
        </Border>
    </Grid>
</Page>
